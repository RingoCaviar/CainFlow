    {
      "pattern": "^css/(features/preview-controls|modules/10-fullscreen-preview)\\.css$",
      "tests": ["tests/preview-button-alignment-app-browser.test.mjs", "tests/fullscreen-preview-actions.test.mjs"]
    },
    {
      "pattern": "^css/prompt-agent\\.css$",
      "tests": ["tests/prompt-agent-conversation-design-browser.test.mjs"]
    },
    {
      "pattern": "^(js/features/media/image-result-actions\\.js|css/features/image-result-actions\\.css)$",
