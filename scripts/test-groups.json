  "rules": [
    {
      "pattern": "^scripts/(test-(plan\\.mjs|groups\\.json)|run-(tests|browser-tests)\\.mjs|check-(daily|full)\\.ps1)$|^tests/(.*\\.test\\.mjs|.*test_[^/]+\\.py)$",
      "tests": ["tests/test-plan.test.mjs"]
    },
    {
      "pattern": "^(scripts/(build-release-local|run-local-regression|validate-release-[^/]+)\\.ps1|\\.github/workflows/release\\.yml)$",
      "tests": ["tests/release-readiness-script.test.mjs", "tests/release-version-rule.test.mjs"]
    },
    {
      "pattern": "^(requirements\\.txt|server\\.py|backend/(main|handler|config)\\.py)$",
      "tests": ["tests/backend-browser-port.test.mjs", "tests/test_http_server_lifecycle.py"]
    },
    {
      "pattern": "^requirements-mcp\\.txt$|^backend/(routes|services)/canvas_mcp_",
      "tests": ["tests/test_canvas_mcp_bridge.py", "tests/canvas-mcp-settings-app-browser.test.mjs"]
    },
    {
      "pattern": "^(index\\.(js|html)|js/app/bootstrap(-impl)?\\.js|js/app/(create-app-[^/]+|register-global-bridges)\\.js)$",
      "tests": ["tests/application-module-parse.test.mjs", "tests/bootstrap-readiness.test.mjs", "tests/startup-recovery-browser.test.mjs"]
    },
    {
      "pattern": "^js/app/bootstrap/settings-bootstrap\\.js$|^css/features/settings(-theme-skin)?\\.css$|^css/modules/12-settings-config\\.css$",
      "tests": ["tests/settings-automation-browser.test.mjs", "tests/settings-theme-surface-browser.test.mjs"]
    },
    {
      "pattern": "^js/features/settings/(canvas-mcp-settings|general-settings|settings-context)\\.js$",
      "tests": ["tests/canvas-mcp-settings-app-browser.test.mjs", "tests/settings-automation-browser.test.mjs"]
