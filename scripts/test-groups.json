{
  "groups": [
    "agent",
    "conversation",
    "protocol",
    "settings",
    "workflow",
    "media",
    "history",
    "nodes",
    "canvas",
    "ui",
    "theme",
    "desktop",
    "update",
    "backend",
    "tooling"
  ],
  "rules": [
    {
      "pattern": "^(AGENTS\\.md|scripts/|\\.github/|requirements[^/]*|package[^/]*|tests/helpers/|tests/fixtures/|docs/testing\\.md|docs/agents/)",
      "full": true,
      "reason": "Test/process infrastructure"
    },
    {
      "pattern": "^(index\\.(js|html)|server\\.py|js/(app|core|runtime|connections)/|backend/(main|config)\\.py|css/)",
      "full": true,
      "reason": "Shared application infrastructure"
    },
    {
      "pattern": "^js/features/(execution|persistence|workflow)/|^js/services/(api-client|storage-|browser-storage|workflow-api)|^backend/.*(storage|migration|workflow|undo|http_server)",
      "full": true,
      "reason": "Shared execution or persistence"
    },
    {
      "pattern": "^js/features/ui/(theme-controller|surface-coordinator|dialog-style|app-dialogs|animation-controller|canvas-navigation|canvas-ui-controller|clipboard-controller|context-menu-controller|global-interactions|image-first-canvas|image-input-detail|node-picker|panel-manager|runtime-controller|shortcut-guard|toolbar-controller|ui-controller|ui-utils|workspace-mode-controller)|^js/nodes/(node-(lifecycle|dom-bindings|serializer|view-factory)|registry)\\.",
      "full": true,
      "reason": "Shared UI or node lifecycle"
    },
    {
      "pattern": "^js/features/prompt-agent/",
      "groups": [
        "agent",
        "conversation",
        "protocol",
        "workflow"
      ]
    },
    {
      "pattern": "^js/features/conversation/",
      "groups": [
        "conversation",
        "agent",
        "workflow"
      ]
    },
    {
      "pattern": "^js/features/settings/",
      "groups": [
        "settings",
        "protocol",
        "ui"
      ]
    },
    {
      "pattern": "^js/features/update/",
      "groups": [
        "update",
        "desktop"
      ]
    },
    {
      "pattern": "^js/features/history/",
      "groups": [
        "history",
        "media"
      ]
    },
    {
      "pattern": "^js/features/media/",
      "groups": [
        "media",
        "nodes"
      ]
    },
    {
      "pattern": "^js/features/camera/",
      "groups": [
        "nodes",
        "canvas",
        "theme"
      ]
    },
    {
      "pattern": "^js/features/ui/",
      "groups": [
        "ui",
        "theme"
      ]
    },
    {
      "pattern": "^js/features/prompts/",
      "groups": [
        "agent",
        "ui"
      ]
    },
    {
      "pattern": "^js/features/logs/",
      "groups": [
        "ui"
      ]
    },
    {
      "pattern": "^js/features/statistics/",
      "groups": [
        "agent",
        "conversation"
      ]
    },
    {
      "pattern": "^js/features/help/",
      "groups": [
        "ui"
      ]
    },
    {
      "pattern": "^js/nodes/",
      "groups": [
        "nodes",
        "canvas",
        "media",
        "protocol"
      ]
    },
    {
      "pattern": "^js/(protocols|api)/",
      "groups": [
        "protocol",
        "settings",
        "nodes",
        "agent"
      ]
    },
    {
      "pattern": "^js/services/desktop-bridge\\.js$",
      "groups": [
        "desktop",
        "update",
        "workflow"
      ]
    },
    {
      "pattern": "^js/services/conversation-api\\.js$",
      "groups": [
        "conversation",
        "agent"
      ]
    },
    {
      "pattern": "^js/services/(notification-sw|system-notification-service|diagnostic-client)\\.js$",
      "groups": [
        "ui",
        "desktop"
      ]
    },
    {
      "pattern": "^backend/",
      "groups": [
        "backend"
      ]
    },
    {
      "pattern": "^backend/.*(desktop|update)",
      "groups": [
        "desktop",
        "update",
        "workflow"
      ]
    },
    {
      "pattern": "^backend/.*conversation",
      "groups": [
        "conversation",
        "agent"
      ]
    },
    {
      "pattern": "^backend/.*(media|cache|search_image)",
      "groups": [
        "media",
        "history",
        "nodes"
      ]
    },
    {
      "pattern": "^backend/.*protocol",
      "groups": [
        "protocol",
        "settings"
      ]
    },
    {
      "pattern": "^workflows/",
      "groups": [
        "workflow",
        "nodes"
      ]
    },
    {
      "pattern": "^(docs/|README[^/]*|LICENSE[^/]*|.*\\.md$)",
      "ignore": true
    }
  ],
