        "conversation",
        "agent"
      ]
    },
    {
      "pattern": "^js/services/(notification-sw|system-notification-service|diagnostic-client)\\.js$",
      "groups": [
        "ui",
        "desktop"
      ]
    },
    {
      "pattern": "^backend/",
      "groups": [
        "backend"
      ]
    },
    {
      "pattern": "^backend/.*(desktop|update)",
      "groups": [
        "desktop",
        "update",
        "workflow"
      ]
    },
    {
      "pattern": "^backend/.*conversation",
      "groups": [
        "conversation",
        "agent"
      ]
    },
    {
      "pattern": "^backend/.*(media|cache|search_image)",
      "groups": [
        "media",
        "history",
        "nodes"
      ]
    },
    {
      "pattern": "^backend/.*protocol",
      "groups": [
        "protocol",
        "settings"
      ]
    },
    {
      "pattern": "^workflows/",
      "groups": [
        "workflow",
        "nodes"
      ]
    },
    {
      "pattern": "^(docs/|README[^/]*|LICENSE[^/]*|.*\\.md$)",
      "ignore": true
    },
    {
      "pattern": "^\\.impeccable/config\\.json$",
      "ignore": true
    }
